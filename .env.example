# 数据库
DATABASE_URL="postgresql://crowd:crowd@localhost:5432/crowd_demand?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT 会话密钥（生产用 openssl rand -base64 32 生成）
AUTH_SECRET="dev-only-secret-change-me-in-production-please-32chars"

# 短信/邮件适配器：mock | aliyun | tencent
SMS_ADAPTER="mock"
EMAIL_ADAPTER="mock"

# 支付/托管适配器：mock | licensed（生产必须持牌机构）
PAYMENT_ADAPTER="mock"

# 实名认证适配器：mock | third-party
KYC_ADAPTER="mock"

# 单笔承诺上限（分），默认 50000.00 元
MAX_PLEDGE_AMOUNT_CENTS="5000000"
# 单人累计承诺上限（分），默认 200000.00 元
MAX_USER_PLEDGE_CENTS="20000000"

# 应用基础地址
NEXT_PUBLIC_APP_URL="http://localhost:3000"
