# 数据库
DATABASE_URL="postgresql://crowd:crowd@localhost:5432/crowd_demand?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT 会话密钥（生产用 openssl rand -base64 32 生成）
AUTH_SECRET="dev-only-secret-change-me-in-production-please-32chars"

# 短信适配器：mock | aliyun | tencent；邮件适配器：mock | smtp
SMS_ADAPTER="mock"
EMAIL_ADAPTER="mock"

# 真实邮件（EMAIL_ADAPTER=smtp 时必填 HOST/USER/PASS）
# QQ：smtp.qq.com:465；163：smtp.163.com:465；PASS 为 SMTP 授权码（非邮箱登录密码）
#SMTP_HOST=smtp.qq.com
#SMTP_PORT=465
#SMTP_SECURE=true
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=

# 阿里云短信（SMS_ADAPTER=aliyun 时必填；签名/模板需先审核通过，模板变量 ${code}）
#ALIYUN_SMS_ACCESS_KEY_ID=
#ALIYUN_SMS_ACCESS_KEY_SECRET=
#ALIYUN_SMS_SIGN_NAME=
#ALIYUN_SMS_TEMPLATE_CODE=
#ALIYUN_SMS_TEMPLATE_PARAM=code

# 腾讯云短信（SMS_ADAPTER=tencent 时必填；签名/模板需先审核通过，模板变量 {1}）
#TENCENT_SMS_SECRET_ID=
#TENCENT_SMS_SECRET_KEY=
#TENCENT_SMS_SDK_APP_ID=
#TENCENT_SMS_SIGN_NAME=
#TENCENT_SMS_TEMPLATE_ID=
#TENCENT_SMS_REGION=ap-guangzhou

# 支付/托管适配器：mock | licensed（生产必须持牌机构）
PAYMENT_ADAPTER="mock"

# 实名认证适配器：mock | third-party
KYC_ADAPTER="mock"

# 单笔承诺上限（分），默认 50000.00 元
MAX_PLEDGE_AMOUNT_CENTS="5000000"
# 单人累计承诺上限（分），默认 200000.00 元
MAX_USER_PLEDGE_CENTS="20000000"

# 应用基础地址
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 内部定时任务密钥（≥16 位；未配置时 /api/internal/cron 一律拒绝）
CRON_SECRET="dev-only-cron-secret-change-me"

# F29 需求采集：来源 csdn/weixin/juejin/v2ex/hn/reddit（逗号分隔）、节流分钟数、单来源超时毫秒
CLUE_SOURCES="csdn,weixin,juejin,douyin,kuaishou,hn"
# 采集间隔（分钟）：v0.8 每 10 分钟一轮，候选写入 ClueCandidate 缓冲区
CLUE_INGEST_INTERVAL_MIN="10"
# 小时聚合间隔（分钟）：把窗口内约 6 轮候选交模型聚类后入库
CLUE_ANALYZE_INTERVAL_MIN="60"
CLUE_ANALYZE_MAX_ITEMS="200"
CLUE_QUERIES_PER_ROUND="4"
CLUE_FETCH_TIMEOUT_MS="15000"
# 轮次是否直接入库（false = 交给小时聚合统一入库）
CLUE_ROUND_INGEST="false"
# 可选：联网搜索 API（配置 URL/KEY 后启用 websearch 来源）
CLUE_SEARCH_API_URL=""
CLUE_SEARCH_API_KEY=""

# 可选：OpenAI 兼容大模型整合（三项齐备才启用，留空则走规则聚合）
# LLM_BASE_URL="https://api.deepseek.com/v1"
# LLM_API_KEY=""
# LLM_MODEL="deepseek-chat"
# LLM_WIRE_API="chat"   # chat=/chat/completions（默认）；responses=/responses

# 附件存储目录（默认 ./storage/uploads，生产建议挂载独立卷）
UPLOAD_DIR="./storage/uploads"

# 备用模型（可选）：主模型调用失败时自动回退，配置方式与主模型一致
# LLM_FALLBACK_BASE_URL="https://token.sensenova.cn/v1"
# LLM_FALLBACK_API_KEY=""
# LLM_FALLBACK_MODEL="sensenova-6.8-flash-lite"
# LLM_FALLBACK_WIRE_API="chat"
