# 生产环境变量模板
# 复制为 deploy/.env.production 后修改（该文件已被 .gitignore 忽略）

# ---------- 数据库 ----------
POSTGRES_USER=crowd
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=crowd_demand

# ---------- 应用 ----------
# 生成方式：openssl rand -base64 48
AUTH_SECRET=CHANGE_ME_openssl_rand_base64_48

# 对外访问地址（影响 Cookie 与绝对链接），部署到虚拟机时填实际 IP
NEXT_PUBLIC_APP_URL=http://192.168.100.91

# Nginx 对外端口
HTTP_PORT=80

# ---------- 部署环境语义 ----------
# production（默认，最严格）：NODE_ENV=production 且 PAYMENT_ADAPTER=mock 时启动即失败
# demo：仅内部演示/验收，显式放行 Mock 支付适配器（会在日志打印告警），严禁接待真实资金
APP_ENV=production

# ---------- 会话 Cookie ----------
# auto（默认）：按 nginx 透传的 X-Forwarded-Proto 判断，https 才加 Secure 属性。
# 明文 HTTP 部署（如 http://192.168.x.x:8000）必须保持 auto（或显式 false）；
# 若写成 true，浏览器会丢弃会话 Cookie，表现为"密码正确、接口返回成功，但页面又被弹回登录页"。
#SESSION_COOKIE_SECURE=auto

# ---------- 内部定时任务 ----------
# 到期结算 cron 调用的密钥，必须与 compose 中的 CRON_SECRET 一致（≥16 字符）
# 生成方式：openssl rand -hex 24
CRON_SECRET=CHANGE_ME_openssl_rand_hex_24

# ---------- F29 平台需求采集（v0.8 两段式） ----------
# 采集来源，逗号分隔：国内 csdn / weixin / juejin / douyin / kuaishou / websearch，海外 v2ex / hn / reddit
# 演示数据源（mock）已移除；单渠道失败不影响其他渠道
# douyin / kuaishou 抓公开搜索页（无登录态、不绕过签名，可能解析不到，属预期内降级）
# websearch 需同时配置 CLUE_SEARCH_API_URL / CLUE_SEARCH_API_KEY 才启用
#CLUE_SOURCES=csdn,weixin,juejin,douyin,kuaishou,hn
# 第一段：采集间隔（分钟），cron 每 5 分钟触发但按此间隔真正抓取，结果写候选缓冲区
#CLUE_INGEST_INTERVAL_MIN=10
# 第二段：小时聚合间隔（分钟）、单次交模型的最大候选条数
#CLUE_ANALYZE_INTERVAL_MIN=60
#CLUE_ANALYZE_MAX_ITEMS=200
# 单轮使用的检索词条数（按轮次轮换，避免每轮重抓同一批结果页）
#CLUE_QUERIES_PER_ROUND=4
# 轮次是否直接入库（false = 由小时聚合统一聚类入库，推荐）
#CLUE_ROUND_INGEST=false
# 单个来源 HTTP 超时（毫秒）
#CLUE_FETCH_TIMEOUT_MS=15000
# 可选：通用联网搜索 API（POST {url} {"query","count"}，返回兼容 data/results/web.value/organic_results）
#CLUE_SEARCH_API_URL=
#CLUE_SEARCH_API_KEY=

# ---------- 可选：OpenAI 兼容大模型整合 ----------
# 三项齐备才启用；留空则只走本地规则聚合。发往模型的内容仅脱敏后的标题与摘要
#LLM_BASE_URL=https://api.deepseek.com/v1
#LLM_API_KEY=
#LLM_MODEL=deepseek-chat
# 接口协议：chat=/chat/completions（默认）；responses=/responses
#LLM_WIRE_API=chat

# ---------- 外部适配器 ----------
# mock = 本地模拟（生产环境若为 mock，短信不会真正发出，支付不会真正扣款）
# 接入真实服务前必须替换，否则关键流程不可用
SMS_ADAPTER=mock
KYC_ADAPTER=mock
# 合规红线：正式对外提供服务时必须是 licensed（持牌机构托管），不得为 mock
PAYMENT_ADAPTER=mock
EMAIL_ADAPTER=mock

# ---------- 真实邮件（EMAIL_ADAPTER=smtp 时启用） ----------
# QQ 邮箱示例：SMTP_HOST=smtp.qq.com SMTP_PORT=465 SMTP_SECURE=true
#   SMTP_USER=你的QQ号@qq.com  SMTP_PASS=SMTP授权码（设置→账号→开启SMTP服务生成，不是QQ密码）
# 163 邮箱示例：SMTP_HOST=smtp.163.com 其余同上（授权码在 设置→POP3/SMTP 中生成）
# Gmail 示例：SMTP_HOST=smtp.gmail.com SMTP_PASS=应用专用密码
#SMTP_HOST=
#SMTP_PORT=465
#SMTP_SECURE=true
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=

# ---------- 阿里云短信（SMS_ADAPTER=aliyun 时启用） ----------
# 前提：签名与模板已审核通过；模板变量形如 ${code}
#ALIYUN_SMS_ACCESS_KEY_ID=
#ALIYUN_SMS_ACCESS_KEY_SECRET=
#ALIYUN_SMS_SIGN_NAME=
#ALIYUN_SMS_TEMPLATE_CODE=
#ALIYUN_SMS_TEMPLATE_PARAM=code

# ---------- 腾讯云短信（SMS_ADAPTER=tencent 时启用） ----------
# 前提：签名与模板已审核通过；模板变量为 {1}
#TENCENT_SMS_SECRET_ID=
#TENCENT_SMS_SECRET_KEY=
#TENCENT_SMS_SDK_APP_ID=
#TENCENT_SMS_SIGN_NAME=
#TENCENT_SMS_TEMPLATE_ID=
#TENCENT_SMS_REGION=ap-guangzhou

# ---------- 业务限额（单位：分）----------
MAX_PLEDGE_AMOUNT_CENTS=5000000
MAX_USER_PLEDGE_CENTS=20000000

# 备用模型（可选）：主模型调用失败时自动回退
#LLM_FALLBACK_BASE_URL=https://token.sensenova.cn/v1
#LLM_FALLBACK_API_KEY=
#LLM_FALLBACK_MODEL=sensenova-6.8-flash-lite
#LLM_FALLBACK_WIRE_API=chat
