generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 枚举：状态机与角色（集中定义，禁止在 UI 层判断业务状态）
// ============================================================

enum UserRole {
  REQUESTER   // 需求发起者
  BACKER      // 支持者
  BUILDER     // 开发者
  OPERATOR    // 运营方
}

enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum NeedStatus {
  DRAFT       // 草稿
  COLLECTING  // 征集中（发布后）
  PLEDGING    // 承诺中（达到票数门槛）
  BIDDING     // 竞标中（承诺达标，资金锁定）
  IN_PROGRESS // 开发中
  ACCEPTING   // 验收中
  COMPLETED   // 已完成
  FAILED      // 已流拍
  REFUNDED    // 已退款
}

/// 需求模式（PRD v0.2）：决定"怎么进入可接单状态"和"钱从哪来"。
enum NeedMode {
  CROWDFUND   // 众筹：投票 → 付费承诺达标 → 解锁（多人出资）
  BOUNTY      // 有偿悬赏：需求方预付全额托管，发布即可收方案（单人出资）
  OPEN        // 无偿认领：无资金，发布即可收方案
}

enum PledgeStatus {
  FROZEN      // 已冻结在托管
  LOCKED      // 达标后锁定
  RELEASED    // 已放款
  REFUNDED    // 已退还
}

enum ProposalStatus {
  SUBMITTED
  SELECTED    // 中标
  REJECTED
  WITHDRAWN
}

enum MilestoneStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  DISPUTED
  RELEASED
}

enum LedgerDirection {
  DEBIT       // 借：资金流出账户
  CREDIT      // 贷：资金流入账户
}

enum LedgerAccountType {
  BACKER      // 支持者承诺账户（虚拟）
  ESCROW      // 平台托管账户（虚拟，对应持牌机构账户）
  BUILDER     // 开发者收款账户（虚拟）
}

enum AuditAction {
  AUTH
  ROLE
  KYC
  NEED
  VOTE
  PLEDGE
  LEDGER
  PROPOSAL
  MILESTONE
  PAYOUT
  REFUND
  ADMIN
}

// ============================================================
// 用户与信任（F01 / F02 / F03）
// ============================================================

model User {
  id              String    @id @default(cuid())
  phone           String?   @unique
  email           String?   @unique
  username        String?   @unique       // 用户名密码注册（F32）：小写归一，全局唯一
  nickname        String?
  avatarUrl       String?
  roles           UserRole[] @default([BACKER])
  kycStatus       KycStatus @default(NONE)
  kycIdNumberHash String?   @unique       // 已实名身份证号 HMAC，一人一号（F02）
  reputationScore Int       @default(0)   // 信誉分（F03）

  // 账号密码登录（F31）：scrypt 哈希，禁止明文；失败锁定防爆破
  passwordHash           String?
  passwordFailedAttempts Int       @default(0)
  passwordLockedUntil    DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  kycRecords      KycRecord[]
  needs           Need[]          @relation("NeedRequester")
  votes           Vote[]
  pledges         Pledge[]
  proposals       Proposal[]      @relation("ProposalBuilder")
  auditLogs       AuditLog[]

  @@index([phone])
  @@index([email])
  @@index([username])
}

model KycRecord {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  realName     String
  idNumberHash String     // 身份证号哈希，禁止明文存储
  provider     String     // 适配器标识：mock / third-party
  status       KycStatus
  reason       String?
  createdAt    DateTime   @default(now())

  @@index([userId])
}

model VerificationCode {
  id        String   @id @default(cuid())
  target    String   // 手机号或邮箱
  channel   String   // sms / email
  codeHash  String   // 验证码哈希，禁止明文
  purpose   String   // LOGIN / KYC
  expiresAt DateTime
  consumedAt DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([target, purpose])
}

// ============================================================
// 需求与投票（F04 / F05 / F06 / F07 / F08）
// ============================================================

model Need {
  id            String     @id @default(cuid())
  requesterId   String
  requester     User       @relation("NeedRequester", fields: [requesterId], references: [id])
  title         String
  description   String     @db.Text
  targetAudience String?
  expectedForm  String?
  attachments   String[]   @default([])  // OSS 对象 key
  status        NeedStatus @default(DRAFT)
  /// 需求模式：众筹 / 悬赏 / 无偿认领（发布后不可更改）
  mode          NeedMode   @default(CROWDFUND)
  /// 悬赏金额（分），仅 BOUNTY 模式非 0；发布时需全额预付进托管
  bountyAmount  BigInt     @default(0)
  /// 方案征集截止时间，仅 BOUNTY / OPEN 使用
  bountyDeadline DateTime?
  voteThreshold Int        @default(100) // 进入承诺期的票数门槛
  voteCount     Int        @default(0)   // 冗余票数，榜单排序用（F07/F08）
  targetAmount  BigInt     @default(0)   // 承诺目标金额（分）
  pledgedAmount BigInt     @default(0)   // 已承诺金额（分），由 F09 维护，榜单排序用
  deadline      DateTime?
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  votes         Vote[]
  statusLogs    NeedStatusLog[]
  pledges       Pledge[]
  proposals     Proposal[]
  projects      Project[]
  bountyEscrow  BountyEscrow?

  @@index([status, publishedAt])
  @@index([status, voteCount])
  @@index([status, pledgedAmount])
  @@index([mode, status])
  @@index([requesterId])
}

/// 悬赏托管（F28）：与 Pledge 分离，避免"一人出资"和"多人承诺"的资金口径混算。
model BountyEscrow {
  id             String   @id @default(cuid())
  needId         String   @unique
  need           Need     @relation(fields: [needId], references: [id])
  /// 预付悬赏总额（分）
  amount         BigInt
  /// 已退还需求方的金额（分）
  refundedAmount BigInt   @default(0)
  /// 支付回执（Mock 为 mock-xxx）
  paymentRef     String?
  /// HELD 托管中 / REFUNDED 已全额退回 / CLOSED 已结清
  status         String   @default("HELD")
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model NeedStatusLog {
  id         String     @id @default(cuid())
  needId     String
  need       Need       @relation(fields: [needId], references: [id])
  fromStatus NeedStatus?
  toStatus   NeedStatus
  reason     String?
  actorId    String?    // 操作者，系统流转时为 null
  createdAt  DateTime   @default(now())

  @@index([needId, createdAt])
}

model Vote {
  id        String   @id @default(cuid())
  needId    String
  need      Need     @relation(fields: [needId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([needId, userId])   // MVP 反刷票：一人一票
  @@index([needId])
}

// ============================================================
// 资金：承诺 / 托管 / 复式账本（F09 / F10 / F16 / F17 / F19）
// 金额一律 BigInt 分；每笔资金操作带幂等键；账本流水不可物理删除
// ============================================================

model Pledge {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  needId        String
  need          Need          @relation(fields: [needId], references: [id])
  amount        BigInt        // 承诺金额（分，整数）
  status        PledgeStatus  @default(FROZEN)
  idempotencyKey String       @unique  // 幂等键，防止重复扣款
  paymentRef    String?       // 托管方流水号
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([needId, status])
  @@index([userId])
}

model LedgerEntry {
  id            String            @id @default(cuid())
  // 复式账本：每笔资金变动由一借一贷两条流水组成
  accountType   LedgerAccountType
  accountId     String            // 虚拟账户标识（用户ID / ESCROW / 开发者ID）
  direction     LedgerDirection
  amount        BigInt            // 分，恒为正数；方向决定增减
  balanceAfter  BigInt            // 余额快照（分）
  bizType       String            // PLEDGE / RELEASE / REFUND
  bizId         String            // 业务单号（pledgeId / payoutId / refundId）
  pledgeId      String?
  pledge        Pledge?           @relation(fields: [pledgeId], references: [id])
  idempotencyKey String            @unique
  memo          String?
  createdAt     DateTime          @default(now())

  @@index([bizType, bizId])
  @@index([accountType, accountId, createdAt])
}

model PaymentOrder {
  id            String   @id @default(cuid())
  idempotencyKey String  @unique
  type          String   // FREEZE / RELEASE / REFUND
  amount        BigInt   // 分
  status        String   // PENDING / SUCCESS / FAILED
  gateway       String   // mock / licensed
  gatewayRef    String?
  payload       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type, status])
}

// ============================================================
// 提案 / 项目 / 里程碑 / 放款（F12 / F13 / F14 / F15 / F16 / F17）
// ============================================================

model Proposal {
  id             String         @id @default(cuid())
  needId         String
  need           Need           @relation(fields: [needId], references: [id])
  builderId      String
  builder        User           @relation("ProposalBuilder", fields: [builderId], references: [id])
  understanding  String         @db.Text   // 需求理解
  spec           String         @db.Text   // 可执行规格
  quote          BigInt         // 报价（分）
  durationDays   Int            // 工期
  pastCases      String?        @db.Text
  status         ProposalStatus @default(SUBMITTED)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  milestones     Milestone[]
  projects       Project[]
  votes          ProposalVote[]

  @@unique([needId, builderId])   // 一个开发者对一个需求只提交一份提案
  @@index([needId, status])
  @@index([builderId])
}

model ProposalVote {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  userId     String
  weight     BigInt   // 依据承诺金额的投票权重（分）
  createdAt  DateTime @default(now())

  @@unique([proposalId, userId])
}

model Project {
  id             String   @id @default(cuid())
  needId         String   @unique   // 一个需求只能有一个中标项目
  need           Need     @relation(fields: [needId], references: [id])
  proposalId     String
  proposal       Proposal @relation(fields: [proposalId], references: [id])
  status         String   @default("IN_PROGRESS")
  totalAmount    BigInt   // 托管总金额（分）
  releasedAmount BigInt   @default(0) // 已释放（分）
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  milestones     Milestone[]
  payouts        Payout[]

  @@index([status])
}

model Milestone {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id])
  proposalId   String
  proposal     Proposal        @relation(fields: [proposalId], references: [id])
  seq          Int             // 序号
  title        String
  deliverable  String          @db.Text
  releaseRatio Int             // 放款比例（0-10000，万分比，避免小数）
  releaseAmount BigInt         // 放款金额（分）
  status       MilestoneStatus @default(PENDING)
  submittedAt  DateTime?
  acceptedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([projectId, seq])
}

model Payout {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  milestoneId   String?
  payeeId       String   // 开发者用户ID
  amount        BigInt   // 分
  status        String   @default("PENDING")
  idempotencyKey String  @unique
  gatewayRef    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
}

// ============================================================
// 后台：审计日志 / 举报（F18 / F19 / F20）
// ============================================================

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id])
  target    String?     // 被操作对象（如 need:xxx）
  detail    Json?
  ip        String?
  createdAt DateTime    @default(now())

  @@index([action, createdAt])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  targetType  String   // NEED / PROPOSAL / USER
  targetId    String
  reason      String   @db.Text
  status      String   @default("PENDING") // PENDING / RESOLVED / REJECTED
  handledBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}

// ============================================================
// 平台需求采集（F29）：外部公开渠道线索 + 提及聚合
// ============================================================

enum ClueStatus {
  COLLECTED // 已采集（默认，公开热榜可见）
  FEATURED  // 运营收录（热榜加权展示徽标）
  DISCARDED // 运营丢弃（不再展示、不再合并新提及）
}

/// 采集来源（渠道）：支持启用/停用，key 与适配器一一对应
model DemandSource {
  key       String   @id // mock / v2ex / hn / reddit
  name      String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// 需求线索：同一痛点的多条外部提及聚合为一条
model DemandClue {
  id             String     @id @default(cuid())
  title          String
  summary        String     @db.Text
  keywords       String[]   // 聚合匹配用关键词（标题指纹归一）
  status         ClueStatus @default(COLLECTED)
  mentionCount   Int        @default(0) // 提及总次数（冗余，与 ClueMention 同步）
  mentionerCount Int        @default(0) // 提及人数（按来源+作者哈希去重）
  firstSeenAt    DateTime   @default(now())
  lastSeenAt     DateTime   @default(now())
  reviewedBy     String?
  reviewedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  mentions ClueMention[]

  @@index([status, mentionerCount])
  @@index([status, mentionCount])
}

/// 单条外部提及：只存公开内容与来源链接；作者仅存哈希，不落个人信息
model ClueMention {
  id          String     @id @default(cuid())
  clueId      String
  clue        DemandClue @relation(fields: [clueId], references: [id])
  sourceKey   String
  externalId  String // 来源侧唯一 ID，幂等去重
  authorKey   String // sha256(sourceKey:authorId)，不可逆
  url         String
  excerpt     String     @db.Text // 已脱敏公开摘要（≤300 字）
  mentionedAt DateTime
  createdAt   DateTime   @default(now())

  @@unique([sourceKey, externalId])
  @@index([clueId])
}

/// 定时任务运行状态（节流用），key 如 clue-ingest
model CronState {
  key       String   @id
  lastRunAt DateTime
}

/// 单轮采集候选缓冲区（F29 v0.8 小时聚合用）
/// 单轮只做筛选并写入这里，每小时任务再把这 6 轮候选合并交模型做跨条聚类，最后统一入库
model ClueCandidate {
  id          String   @id @default(cuid())
  sourceKey   String
  externalId  String
  title       String
  excerpt     String   @db.Text
  url         String
  authorKey   String
  mentionedAt DateTime
  roundId     String // 采集轮次标识（YYYYMMDDHHmm）
  fetchedAt   DateTime @default(now())
  usedAt      DateTime? // 已被小时聚合消费的时间

  @@unique([sourceKey, externalId])
  @@index([fetchedAt])
  @@index([usedAt])
}

/// 模型生成的检索词（F29 v0.8）：每小时生成一批，采集轮次轮换使用
model ClueQuery {
  id        String   @id @default(cuid())
  query     String
  origin    String   @default("llm") // fixed | llm
  createdAt DateTime @default(now())

  @@unique([query])
  @@index([createdAt])
}
